model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  published Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime? @updatedAt
  created_by      String?
  updated_by      String?  

  authorId String
  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("posts")
  @@schema("layer")
}